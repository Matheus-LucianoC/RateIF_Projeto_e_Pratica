{
  "expo": {
    "name": "RateIF Mobile",
    "slug": "rateif-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.rateif.mobile",
      "versionCode": 1,
      "permissions": [],
      "usesCleartextTraffic": true
    },
    "ios": {
      "bundleIdentifier": "com.rateif.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": ""
    }
  }
}
